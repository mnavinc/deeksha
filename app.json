{
  "expo": {
    "name": "Swamiseva",
    "slug": "swamiseva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deekshajourney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#F7931E",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#0B2D6B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deekshajourney.app",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find nearby temples and pilgrimage checkpoints during your Yatra."
      }
    },
    "android": {
      "package": "com.deekshajourney.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B2D6B"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "deeksha-sigma.vercel.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Swamiseva to find nearby temples during your pilgrimage."
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
