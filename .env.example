# -----------------------------------------------------------------------------
# Deeksha Journey — Enterprise Environment Configuration Template
# Copy this file to .env and replace with secure values before running in production.
# -----------------------------------------------------------------------------

# Runtime Environment Mode: 'development' | 'test' | 'production'
NODE_ENV=development

# Server HTTP Port
PORT=3000

# PostgreSQL Database Connection String
# Example: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://deeksha_app:change-me-before-production@localhost:5432/deeksha

# PostgreSQL SSL Configuration
# Set DATABASE_SSL to 'true' or 'require' in cloud environments (AWS RDS, Supabase, Neon, Render)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JSON Web Token Secret (MUST be at least 32 cryptographically random characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-32-character-minimum-secret-key

# Allowed CORS Origins (Supports single origin, wildcard *, or comma-separated URLs)
# Example: https://app.deeksha.org,https://admin.deeksha.org,http://localhost:8081
CORS_ORIGIN=http://localhost:8081

# API Rate Limiting (Requests per window per IP address)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# SMTP Email Configuration (Nodemailer - supports Gmail, AWS SES, SendGrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=DeekshaOrg <noreply@deeksha.app>

# Client Mobile/Web Public API Endpoint
# Configured in Expo Web / Mobile builds to target the production Fastify backend
EXPO_PUBLIC_API_URL=http://localhost:3000
